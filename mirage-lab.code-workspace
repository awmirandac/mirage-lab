{
  "folders": [
    { "name": "mirage-erp-sapi",      "path": "mirage-erp-sapi" },
    { "name": "mirage-erp-sapi-impl", "path": "mirage-erp-sapi-impl" }
  ],
  "settings": {
    "git.openRepositoryInParentFolders": "always",
    "files.eol": "\n",
    "files.exclude": {
      "**/.apivcs": true,
      "**/.gitignore": true,
      "**/.git": true,
      "**/.designer.json": true,
      "**/.exchange.xml": true,
      "**/.vscode": true,
      "**/.mvn": true,
      "**/mvnw": true,
      "**/mvnw.cmd": true,
      "**/.tmp": true,
      "**/.settings": true,
      "**/.exchange_modules_tmp": true,
      "**/.github": true
    },
    "editor.acceptSuggestionOnEnter": "on",
    "editor.wordBasedSuggestions": "off",
    "testing.coverageBarThresholds": {
      "red": 0,
      "yellow": 60,
      "green": 90
    },
    "testing.displayedCoveragePercent": "statement"
  }
}
