<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

    <!-- Caminos tristes del endpoint: se entra por HTTP real para atravesar el error handler del flujo -main.
         El puerto ${http.port} lo asigna MUnit dinámicamente (ver <dynamicPorts> en el pom.xml),
         así la suite no choca con la app corriendo por F5 en el 8081. -->
    <munit:config name="mirage-erp-sapi-errors-test-suite.xml"/>

    <!-- Cliente HTTP del test: apunta al listener de la app bajo prueba. Acepta cualquier status
         (200..599) para poder afirmar sobre el 500 en lugar de que el requester lo convierta en error. -->
    <http:request-config name="apiUnderTest" doc:name="API bajo prueba">
        <http:request-connection host="localhost" port="${http.port}"/>
    </http:request-config>

    <munit:test name="erp-caido-devuelve-500-ERP_UNAVAILABLE"
                description="Si la base falla, la API responde 500 con el esquema Error y code ERP_UNAVAILABLE, sin filtrar detalles internos">

        <!-- El error handler vive en el flujo -main, delante del router APIkit. Para atravesarlo hay que
             entrar por HTTP: se enciende SOLO el listener de ese flujo (MUnit apaga todos los sources).
             MUnit inicializa perezosamente: solo los flujos listados aquí (o referenciados por flow-ref)
             existen durante el test. El router APIkit busca el flujo del endpoint en tiempo de ejecución;
             si no está inicializado responde 501, por eso también se lista. -->
        <munit:enable-flow-sources>
            <munit:enable-flow-source value="mirage-erp-sapi-main"/>
            <munit:enable-flow-source value="get:\products\(sku)\availability:mirage-erp-sapi-config"/>
        </munit:enable-flow-sources>

        <munit:behavior>
            <munit-tools:mock-when doc:name="Simular ERP caido" processor="db:select">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Consultar inventario en ERP"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:error typeId="DB:CONNECTIVITY"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <http:request doc:name="GET /api/products/MIRAGE-TEST-2/availability" config-ref="apiUnderTest"
                          method="GET" path="/api/products/MIRAGE-TEST-2/availability">
                <http:response-validator>
                    <http:success-status-code-validator values="200..599"/>
                </http:response-validator>
            </http:request>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that doc:name="status 500"          expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(500)]"/>
            <munit-tools:assert-that doc:name="code ERP_UNAVAILABLE" expression="#[payload.code]"          is="#[MunitTools::equalTo('ERP_UNAVAILABLE')]"/>
            <munit-tools:assert-that doc:name="message presente"     expression="#[payload.message]"       is="#[MunitTools::notNullValue()]"/>
            <munit-tools:assert-that doc:name="sin stack trace"      expression="#[payload.message]"       is="#[MunitTools::not(MunitTools::containsString('Exception'))]"/>
        </munit:validation>
    </munit:test>

</mule>
